{
  "name": "tcc-ufrn-web-audit",
  "version": "0.1.0",
  "description": "Análise automatizada de performance e semântica HTML em portais institucionais da UFRN (TCC EAJ/UFRN).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "env": "tsx --env-file-if-exists=.env scripts/env-info.ts",
    "triage": "tsx --env-file-if-exists=.env src/triage/index.ts",
    "collect": "tsx --env-file-if-exists=.env src/collect/index.ts",
    "collect:report": "tsx scripts/collect-report.ts",
    "analyze": "tsx --env-file-if-exists=.env src/analyze/index.ts",
    "recommend": "tsx --env-file-if-exists=.env src/recommend/index.ts",
    "validate": "tsx --env-file-if-exists=.env src/validate/index.ts",
    "report": "tsx --env-file-if-exists=.env src/report/index.ts",
    "ui:server": "tsx src/ui/server.ts",
    "ui": "npm run ui:build && npm run ui:server",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:axe": "tsx scripts/ui-axe.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "jsdom": "31.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vnu-jar": "26.10.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "cheerio": "1.2.0",
    "chrome-launcher": "1.2.2",
    "diff": "9.0.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "lighthouse": "13.5.0",
    "p-limit": "7.3.3",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "undici": "8.12.3"
  }
}
