ão autorizados. A gestão de credenciais fica integralmente sob responsabilidade do provedor escolhido pelo usuário, assegurando maior robustez no processo de autenticação.</p></div></details></div></div></div></div></div><!--$--><!--/$--><section aria-label="Notifications alt+T" tabindex="-1" aria-live="polite" aria-relevant="additions text" aria-atomic="false"></section><script src="/_next/static/chunks/webpack-ecc9dab4f91c1269.js" id="_R_" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,"1:\"$Sreact.fragment\"\n2:I[10790,[\"3328\",\"static/chunks/3328-a2eb4ee7bc040a34.js\",\"1344\",\"static/chunks/1344-5b96d4243d3b1e27.js\",\"6902\",\"static/chunks/6902-7cfed79b780fc288.js\",\"9668\",\"static/chunks/9668-6f7781d29249bf48.js\",\"7177\",\"static/chunks/app/layout-6a04db19e0710607.js\"],\"default\"]\n3:I[88942,[],\"\"]\n4:I[58852,[],\"\"]\n5:I[4499,[\"9123\",\"static/chunks/9123-3c370b4f2cce121d.js\",\"3436\",\"static/chunks/3436-1b1473a58d642671.js\",\"7160\",\"static/chunks/7160-619a76e55e634471.js\",\"7003\",\"static/chunks/7003-59432b0dea4a1a3f.js\",\"1344\",\"static/chunks/1344-5b96d4243d3b1e27.js\",\"5471\",\"static/chunks/5471-b4f1ac4ba598d04b.js\",\"2467\",\"static/chunks/2467-97acdf0af15ce4a1.js\",\"4499\",\"static/chunks/4499-ea300bceda11b133.js\",\"6461\",\"static/chunks/6461-2e5c0ceb7cd0afbb.js\",\"2076\",\"static/chunks/app/(main)/layout-fea85c6c7ed4986e.js\"],\"\"]\n6:I[63005,[\"3328\",\"static/chunks/3328-a2eb4ee7bc040a34.js\",\"1344\",\"static/chunks/1344-5b96d4243d3b1e27.js\",\"6902\",\"static/chunks/6902-7cfed79b780fc288.js\",\"9668\",\"static/chunks/9668-6f7781d29249bf48.js\",\"7177\",\"static/chunks/app/layout-6a04db19e0710607.js\"],\"Toaster\"]\n8:I[17735,[],\"OutletBoundary\"]\na:I[40358,[],\"AsyncMetadataOutlet\"]\nc:I[17735,[],\"ViewportBoundary\"]\ne:I[17735,[],\"MetadataBoundary\"]\nf:\"$Sreact.suspense\"\n11:I[38622,[\"9123\",\"static/chunks/9123-3c370b4f2cce121d.js\",\"5500\",\"st