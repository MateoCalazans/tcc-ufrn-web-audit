nd-card-blue":j,"border-card":k,loadingBar:h,loadingApp:h,"background-inner-app":e,"background-outer-app":n,"menu-toggle":g,"border-nav-dark":i,"border-header":h,"popover-outer-border":e,"popover-border-el":"#353436","border-sidebar":g,"border-dark":u,"border-soft-light":"#EEE","border-light":m,"border-outer-app":n,"border-inner-app":e,"border-soft-dark":"#11327240","panel-background-light":g,"panel-background-dark":i,"text-inner":r,"text-soft-dark":"#164194B3","text-inner-light":"#777777","text-background":e,"link-background":e,"link-background-hover":j,link:g,"link-hover":h,"link-active":g,"link-background-image-hover":j,"link-background-image-hover-2":j,"link-slider-img":h,"link-pagination-hover":"#b5cbf4","border-footer":i,"button-primary-color":e,"button-primary-background":g,"button-primary-background-hover":h,"button-primary-background-active":i,"button-primary-background-disabled":u,"button-secondary":g,"button-secondary-hover":h,"button-secondary-active":i,"button-secondary-disabled":g,"button-negative-primary-color":g,"button-negative-primary-color-hover":e,"button-negative-primary-background":e,"button-negative-primary-background-hover":j,"button-negative-primary-background-active":h,"button-negative-primary-background-disabled":e,"button-negative-secondary":e,"button-negative-secondary-hover":j,"button-negative-secondary-active":h,"button-negative-secondary-disabled":e,"pagination-bullet-active":"#5c8ce7","dialog-success-text":"#6B915C","dialog-success-background":"#CCEDAB","dialog-warning-text":v,"dialog-warning-background":"#F3E3B4","dialog-danger-text":w,"dialog-danger-background":"#FFC3C2","ipt-warning":v,"ipt-warning-with-background":"#FFD34D","ipt-danger":w,"ipt-danger-with-background":"#F58784","ipt-disabled":m,"card-background":n,"card-background-2":m,"card-border":n,"striped-table":x,"striped-table-border":x,"cell-calendar-text":r,"cell-calendar-text-hover":r,"cell-calendar-icon-hover":k,"cell-calendar-icon-border":k,"cell-calendar-hover":k,"sub-header-separator":"#d9d9d9"}},app:{loading:c},apresentacao:{historia:[],missao:[],visao:[],valores:[],objetivos:[],load:d},depoimentos:{depoimentosLista:[],load:c},documentos:{infoDocumentos:[],load:c},duvidasFrequentes:{duvidas:[],pages:f,currentPage:f,load:d,loadMore:c},equipes:{estrutura:[],equipe:[],comite:[],load:d},eventos:{eventos:[],tagsEventos:[],eventosPaginados:[],eventosFiltrado:[],totalPagesFilter:f,totalResultsFilter:f,historyPage:y,totalResults:f,totalPages:f,tipoEventos:{eventosProximos:[],eventosAnteriores:[]},resultados:{totalResultsProximos:f,totalResultsAnteriores:f},pages:{totalPagesProximos:f,totalPagesAnteriores:f},load:{proximo:c,anterior:c},filters:{text:b,keyword:b,date:b}},inclusaoEAcessibilidadeNasUnidades:{cardsInclusaoEAcessibilidade:[{id:"Card01",img:"\u002F_nuxt\u002Fimg\u002Fcriacao-CPIA.231e165.png",titleImg:b,altImg:"Descrição da imagem - Fotografia de reunião da CPIA do CCSA com a participação de quatorze pessoas sentadas ao redor de uma mesa. Em uma cabeceira está a profa. Maria Arlete Duarte (Diretora do CCSA). Da esquerda para direita: Juliana Silva (discente estagiária de Serviço Social na SIA); Ivana Lucena (Pedagoga, servidora de Referência da SIA); prof. Ricardo Lins (Secretário da SIA); Maria Teresa Pires Costa (Professora do curso de Administração); Jeanne Christine Mendes Teixeira (Professora do Curso de Administração); Pâmela de Medeiros Brandão (Assessora Pedagógica do Centro); Telma Elita da Silva (Técnica em Assuntos Educacionais); Késia Cristine de Melo (Psicóloga); Jhullia Ramara (discente estagiária de Serviço Social na SIA); Diego de Maria André (Professor do Curso de Ciências Contábeis); Karine Fechine (Assistente Social da SIA); Valéria Ingrid (discente estagiária de Serviço Social na SIA) e  João Paulo dos Santos Melo (Professor do Curso de Direito). Sobre a mesa e a frente dos participantes, cadernos, papéis e copos descartáveis. Ao fundo, a parede tem tom rosa e uma pintura da praia de Ponta Negra, com barcos a vela e pescadores. Há ainda uma porta e uma janela fechada com persiana (fim da descrição).",title:"Participando da Comissão Permanente de inclusão e Acessibilidade (CPIA)",linkVideo:"https:\u002F\u002Fyoutu.be\u002FWDkrpINgVSk",descricao:"\u003Cp\u003EA Comissão Permanente de Inclusão e Acessibilidade - CPIA, faz parte da rede de apoio à \u003Ca href=\"https:\u002F\u002Farquivos.info.ufrn.br\u002Farquivos\u002F2022072078a51111241036c393c42308eb\u002Fres0022022-atualizar_a_polica_de_inclusao_e_acessiblidade_da_UFRN-assinada.pdf\" target=\"_blank\" rel=\"noopener\" download\u003EPolítica de Inclusão e Acessibilidade para as Pessoas com Necessidades Específicas na UFRN\u003C\u002Fa\u003E, e está presente nas unidades acadêmicas e administrativas, sendo seus membros indicados pela direção da unidade (ou equivalente) e\u002Fou Secretaria de Inclusão e Acessibilidade. Composta por servidores (docentes e técnicos) e estudantes da própria unidade, a CPIA tem como objetivo levantar as demandas dos servidores e estudantes com necessidades específicas e propor ações de acessibilidade que promovam a participação ativa deste público nas atividades profissionais e de ensino-aprendizagem, no âmbito da unidade. Sinta-se convidado(a) a contribuir para a construção de uma cultura inclusiva na UFRN.\u003C\u002Fp\u003E"}],load:c},infoDirecionamentosEspecificos:{infoDeficiencias:[{id:"deficiente-visual",key:"@deficiente-visual",label:"Deficiência visual",active:d,lista:[{tipo:a,label:"Ao falar com uma pessoa com deficiência visual evite se comunicar com gestos ou expressões faciais, pois isso não faz sentido. Converse normalmente, com um tom de voz normal sem falar alto."},{tipo:a,label:"Quando for guiá-la, nunca a agarre ou puxe-a pelo braço. Espere que ela segure o seu braço e seja o mais claro possível ao explicar um caminho ou descrever os obstáculos que existem em um determinado local. Por exemplo: para indicar a presença de degraus, fale as palavras “sobe” ou “desce”. Para explicar direções diga quais obstáculos existem naquela direção. Indique a distância em metros. Exemplo: “dez metros à frente tem uma escada”. Se você não sabe como direcionar essa pessoa, seja franco: “Eu gostaria de ajudar, mas como devo proceder?”."},{tipo:a,label:"Em lugares estreitos ponha seu braço para trás, para que a pessoa possa segui-lo."},{tipo:a,label:"Ao guiar um cego para uma cadeira, direcione suas mãos para o encosto e informe-o se a cadeira tem braços ou não."},{tipo:a,label:"Ao sair de uma sala, informe-a, assim não deixará a pessoa falando sozinha. Não esqueça de apertar sua mão ao encontrá-la ou se despedir."},{tipo:a,label:"Por mais tentador que seja não acaricie um cão-guia, pois ele nunca deve ser distraído."},{tipo:a,label:z},{tipo:a,label:"Devemos evitar palavras como \"ceguinho”, pois são ofensivas e desqualificam a pessoa. Chame-a pelo nome; mas, quando estiver se referindo a ela, o correto é utilizar a expressão pessoa com deficiência visual."}]},{id:"deficiente-fisica",key:"@deficiente-fisica",label:"Deficiência física\u002Fmotora",active:c,lista:[{tipo:a,label:"Não se apóie na cadeira de rodas,bengalas ou muletas. Ela é como uma extensão do corpo da pessoa com deficiência física."},{tipo:a,label:"Nunca movimente a cadeira de rodas sem antes pedir permissão para a pessoa."},{tipo:a,label:"Não receie em falar as palavras “andar” ou “correr”, pois estas pessoas também usam estas palavras."},{tipo:a,label:"Ao convidar uma pessoa cadeirante para ir a algum lugar verifique antes, se esse ambiente está livre da presença de barreiras arquitetônicas para evitar constrangimentos."},{tipo:a,label:"Numa conversa demorada, sente-se de modo a ficar no mesmo nível do olhar da pessoa cadeirante, uma vez que é incomodo ficar muito tempo olhando para cima."},{tipo:a,label:"Ao descer uma rampa inclinada demais, ou degraus, prefira o deslocamento em \"marcha ré\", para evitar que a pessoa perca o equilíbrio e caia para frente."},{tipo:a,label:z},{tipo:a,label:"Empurrar uma pessoa em cadeira de rodas não é como empurrar um carrinho de supermercado. Quando estiver empurrando uma pessoa sentada numa cadeira de rodas e parar para conversar com alguém, lembre-se de virar a cadeira de frente para que a pessoa também possa participar da conversa."},{tipo:a,label:"Se estiver acompanhando uma pessoa usando muletas, procure andar respeitando o ritmo de seus passos."},{tipo:a,label:"Não se escore nas muletas e tome cuidado para não esbarrar nelas, pois a pessoa pode perder o equilíbrio e cair."},{tipo:a,label:"Deixe as muletas sempre ao alcance das mãos da pessoa deficiente."}]},{id:"deficiente-auditiva",key:"@deficiente-auditiva",label:"Deficiência auditiva",active:c,lista:[{tipo:a,label:"Lembre-se que para o surdo, a visão é o sentido primordial da comunicação e, portanto, é bastante desenvolvido. Enquanto estiver conversando, mantenha sempre contato visual. Se você desviar o olhar, a pessoa surda pode achar que a conversa terminou."},{tipo:a,label:"Fale claramente, de frente para a pessoa, tomando cuidado para deixar visível sua boca."},{tipo:a,label:"Não grite, fale em tom de voz e velocidade normais, exceto se lhe pedirem para levantar a voz ou falar mais devagar."},{tipo:a,label:"Fale com expressão. Estas pessoas não podem ouvir as mudanças sutis do tom da voz indicando sarcasmo ou seriedade. Mas elas saberão ler suas expressões faciais, gestos ou movimentos do seu corpo."},{tipo:a,label:"Ao conversar, toque levemente seu braço para a pessoa perceber que você quer falar-lhe. Mantenha o contato visual. Do contrário, a pessoa pensará que a conversa acabou."},{tipo:a,label:"Se você não entender o que um surdo quer lhe dizer, peça para que ele repita. Se mesmo assim você não o entender, peça para que ele escreva o que deseja."},{tipo:a,label:"Se um surdo estiver acompanhado de intérprete, fale diretamente ao surdo, nunca ao intérprete."},{tipo:a,label:"Utilize linguagem de sinais, avisos visuais e, se for exibir um filme, opte por filmes legendados ou providencie um resumo do filme."},{tipo:a,label:"Não cruze ou ande entre duas pessoas conversando em linguagem de sinais, isto atrapalha ou impede a conversa."},{tipo:a,label:"É comum haver associação entre a deficiência auditiva e a deficiência intelectual, por causa da grande movimentação corporal que os surdos desenvolvem para se comunicar. Muitas vezes essas pessoas balançam as mãos, usam gestos fortes e mexem o corpo. Mas essas ações são necessárias para se comunicar, e não comprometem, em hipótese alguma, sua capacidade intelectual."},{tipo:a,label:"Evite usar denominações pejorativas como, por exemplo, “mudinhos”. Palavras desse gênero são ofensivas e carregadas de preconceito."}]},{id:"deficiente-intelectual",key:"@deficiente-intelectual",label:"Deficiência intelectual",active:c,lista:[{tipo:a,label:"Cumprimente-a normalmente. Geralmente, uma pessoa com deficiência intelectual é carinhosa, disposta e comunicativa."},{tipo:a,label:"Expresse alegria ao encontrá-la, dê-lhe atenção e procure conversar com ela."},{tipo:a,label:"Evite a superproteção, seja a pessoa uma criança, um jovem, adulto ou idoso. Ajude-a somente quando for necessário."},{tipo:a,label:"Não trate pessoas jovens, adultas ou idosas com deficiência intelectual de maneira infantilizada. Só a trate como uma criança se for uma criança."}]}],collapses:[{id:"o-que-sao-pessoas-com-deficiência",title:"O que são pessoas com deficiência?",videoUrl:"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=QOqlkRJXe6A",content:"\u003Cp\u003ESão aquelas que apresentam em caráter permanente uma restrição física, mental e\u002Fou sensorial (auditiva e visual), que em interação com o meio ambiente encontra restrições (limitações ou impedimentos) em sua participação em decorrência das barreiras impostas pela sociedade.\u003C\u002Fp\u003E"},{id:"como-nos-referir-as-pessoas-com-deficiencia",title:"Como nos referir as pessoas com deficiência?",videoUrl:"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=OQcr-WFdi_s",content:"\u003Cp\u003EPelo seu nome ou simplesmente pelo próprio termo pessoas com deficiência. Hoje em dia, este é o termo mais utilizado em todo o mundo, não por ser politicamente correto, mas porque, desta forma, a questão substantiva (“pessoas”) possui mais importância do que o aspecto adjetivo (“com deficiência”). Com o avanço da ciência e o conhecimento das potencialidades dessas pessoas, termos que eram e ainda são utilizados para se referir as mesmas, tais como: retardado, mongol, doidinho, manco, coxo, aleijado, entre tantos outros, não devem ser mais utilizados, pois denotam preconceito e idéia de inferioridade. Sabemos que mais importante do que a mudança da terminologia é a mudança de atitude perante essas pessoas. Do que adianta se referir as pessoas com deficiência pelo seu nome, se não as respeitamos em suas necessidades e diferenças.\u003C\u002Fp\u003E"},{id:"as-pessoas-com-deficiencia",title:"As pessoas com deficiência possuem as mesmas características e necessidades?",videoUrl:"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=bgfNOJxAO5M",content:"\u003Cp\u003ENão. Cada tipo de deficiência possui singularidades e necessidades próprias. Uma pessoa cega possui singularidades diferentes de uma pessoa surda, assim como uma pessoa que usa cadeira de rodas ou muletas em relação a uma pessoa com deficiência intelectual. Enquanto uma pessoa cega possui dificuldades de orientação, uma pessoa com mobilidade reduzida, que faz uso de cadeira de rodas, terá dificuldades de locomoção. Já aquela que é surda tem dificuldades de comunicação e a que tem deficiência intelectual expressa níveis diferenciados de limitação intelectual. É importante destacar que os indivíduos com o mesmo tipo de deficiência possuem singularidades próprias, ou seja, não podemos generalizar as pessoas com deficiência como sendo todas iguais.\u003C\u002Fp\u003E"},{id:"tipos-mais-frequentes",title:"Quais são os tipos mais frequentes de deficiência?",videoUrl:"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=hAiaAe1punM",content:"\u003Cul\u003E\u003Cli\u003EDeficiência Visual: pessoa que apresenta baixa visão ou nenhuma visão (pessoas cegas);\u003C\u002Fli\u003E\u003Cli\u003EDeficiência Física ou motora: pessoa que apresenta dificuldade de locomoção ou movimentação;\u003C\u002Fli\u003E\u003Cli\u003EDeficiência Auditiva: pessoa que apresenta dificuldade de escutar e\u002Fou compreender a fala através do ouvido;\u003C\u002Fli\u003E\u003Cli\u003Edeficiência intelectual: pessoa que apresenta limitação intelectual;\u003C\u002Fli\u003E\u003Cli\u003EDeficiência Múltipla: associação de duas ou mais dessas deficiências.\u003C\u002Fli\u003E\u003C\u002Ful\u003E"},{id:"Como-devemos-nos-comportar-diante",title:"Como devemos nos comportar diante de uma pessoa com deficiência?",videoUrl:"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=YV_VgkC0GEk",content:"\u003Cp\u003EAja naturalmente. Não finja que a deficiência não existe. Para pessoas que realmente nunca tiveram a convivência com pessoas com deficiência é comum nos primeiros contatos estranhar ou mesmo sentir-se embaraçada sem saber o que fazer. As pessoas com deficiência, não são pessoas doentes, apenas possuem singularidades que as fazem diferentes das pessoas sem deficiência. Não a veja com sentimento de pena ou de piedade. A veja como uma pessoa que apresenta algumas limitações, mas também com muitas potencialidades, como todos nós temos.\u003C\u002Fp\u003E"}]},infoMenu:{menuSubmenu:[{label:"Início",$url:s,key:"inicial",video:"\u002F_nuxt\u002Fvideos\u002Finicio.ad177ac.mp4"},{label:"Sobre",key:"sobre",isOpen:c,video:"\u002F_nuxt\u002Fvideos\u002FSobre.78e0875.mp4",subitem:[{label:"Apresentação",$url:"\u002Fsobre\u002Fapresentacao",key:"apresentacao",video:"\u002F_nuxt\u002Fvideos\u002FApresentação.1675144.mp4"},{label:"Equipe",$url:"\u002Fsobre\u002Fequipe",key:"equipe",video:"\u002F_nuxt\u002Fvideos\u002FEquipe.440bae9.mp4"}]},{label:"Documentos",$url:"\u002Fdocumentos",key:"documentos",video:"\u