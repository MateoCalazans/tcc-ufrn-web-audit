u002F\u002Fwww.youtube.com\u002Fwatch?v=ANMWgYm0KY0"},centralizaImg:d,role:"Dicas básicas para interagir com pessoas com Necessidades Específicas",$url:"\u002Forientacoes\u002Fdicas-basicas-para-interagir-com-pessoas-com-necessidades-especificas"},{id:"formacao-continuada",thumb:{url:"\u002F_nuxt\u002Fimg\u002Fhomem-caminhando.1937d14.svg",alt:"Homem subindo degraus flutuantes"},libras:{url:"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=MfmsiBNrPHc"},centralizaImg:d,role:"Formação continuada",$url:"\u002Forientacoes\u002Fformacao-continuada"},{id:"como-proporcionar-inclusao",thumb:{url:"\u002F_nuxt\u002Fimg\u002Fcego-atravessando-rua.497af8a.svg",alt:"Homem cego atravessando a rua"},libras:{url:"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=6TXzolPYZTk"},centralizaImg:d,role:"Como proporcionar inclusão e acessibilidade nas unidades",$url:"\u002Forientacoes\u002Fcomo-proporcionar-inclusao-e-acessibilidade-nas-unidades"},{id:"conheca-mais-sobre",thumb:{url:"\u002F_nuxt\u002Fimg\u002Fpessoa-cega.9a81322.svg",alt:"Mulher cega parada com um parque ao fundo"},libras:{url:"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=wT8c5VSoB24"},centralizaImg:c,role:"Conheça mais sobre cada Necessidade Específica",$url:B},{id:"conheca-sobre-politica",thumb:{url:"\u002F_nuxt\u002Fimg\u002Fblog.93acadb.svg",alt:"Blog com imagens de três pessoas"},libras:{url:"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=Z8tF2gw140o"},centralizaImg:d,linkExterno:d,role:"Conheça sobre a Política de Inclusão e Acessibilidade",$url:"https:\u002F\u002Fufrn.br\u002Fresources\u002Fdocumentos\u002Fpoliticas\u002Fpolitica_de_Inclusao_e_Acessibilidade.pdf"},{id:"duvidas-frequentes",thumb:{url:"\u002F_nuxt\u002Fimg\u002Fduvidas.350610d.svg",alt:"Mulher segurando uma interrogação gigante"},libras:{url:"https:\u002F\u002Fwww.youtube.com\u002Fwatch?v=DucabukuyvI"},centralizaImg:d,role:C,$url:D}]},libras:{LIBRAS_POPOVER_VISIBLE:c,LIBRAS_VIDEO:q,IS_POPOVER_OPEN:c},media:{isMobile:c,print:c,device:"desktop"},menu:{menuState:d},noticias:{noticias:[{id:"0e77bc518b784a1b9da08a8d82a79ef1",titulo:"SIA retifica resultado final de seleção do Programa de Orientação e Tutoria Inclusiva",autorfonte:o,datadepublicacao:"2026-10-16",subtitulo:b,descricao:"\u003Cp\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EA Secretaria de Inclusão e Acessibilidade (SIA) da Universidade Federal do Rio Grande do Norte (UFRN) publicou o resultado final retificado do processo seletivo para tutores do Programa de Orientação e Tutoria Inclusiva, por motivo de erro na publicação do arquivo com a lista final de aprovados. A SIA lamenta o equívoco e solicita aos candidatos que confiram o documento atualizado.\u003C\u002Fspan\u003E\u003C\u002Fp\u003E\u003Cp\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EA lista completa está disponível no menu \"Documentos\" - aba \"Editais e Seleções\" do portal da SIA.\u003C\u002Fspan\u003E\u003C\u002Fp\u003E",src:b,tag:[p,l]},{id:"a7c5ca5b5a3b932f79925c19e21be164",titulo:"SIA divulga resultado final da seleção de tutores do Programa de Orientação e Tutoria Inclusiva",autorfonte:o,datadepublicacao:"2026-10-15",subtitulo:b,descricao:"\u003Cp\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EA Secretaria de Inclusão e Acessibilidade (SIA) da Universidade Federal do Rio Grande do Norte (UFRN) torna público o resultado definitivo do processo seletivo para estudantes de graduação interessados em atuar como tutores do Programa de Orientação e Tutoria Inclusiva.\u003C\u002Fspan\u003E\u003C\u002Fp\u003E\u003Cp\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EOs(as) candidatos(as) selecionados(as) para as vagas imediatas serão contatados(as) pela equipe do Programa de Orientação e Tutoria Inclusiva, por meio do endereço eletrônico informado no ato da inscrição, para orientações sobre os procedimentos necessários ao início das atividades.\u003C\u002Fspan\u003E\u003C\u002Fp\u003E\u003Cp\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EOs(as) candidatos(as) classificados(as) para o cadastro de reserva poderão ser convocados(as) posteriormente, conforme o surgimento de demandas compatíveis com seus perfis e a disponibilidade de vagas.\u003C\u002Fspan\u003E\u003C\u002Fp\u003E\u003Cp\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EA lista completa está disponível no menu \"Documentos\" - aba \"Editais e Seleções\" do portal da SIA.\u003C\u002Fspan\u003E\u003C\u002Fp\u003E",src:b,tag:[p,l]},{id:"1e1bebe47a7ab2641ac6081fb106a4a2",titulo:"SIA publica resultado dos recursos da seleção de tutores do Programa de Orientação e Tutoria Inclusiva",autorfonte:o,datadepublicacao:"2026-10-14",subtitulo:b,descricao:"\u003Cp\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EA Secretaria de Inclusão e Acessibilidade (SIA) da Universidade Federal do Rio Grande do Norte (UFRN) torna público o resultado dos recursos referentes à 2ª etapa (entrevista) do processo seletivo para estudantes de graduação interessados em atuar como tutores do Programa de Orientação e Tutoria Inclusiva.\u003C\u002Fspan\u003E\u003C\u002Fp\u003E\u003Cp\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EAs decisões fundamentadas serão encaminhadas individualmente aos candidatos, por meio dos endereços eletrônicos informados no processo seletivo. O resultado final será divulgado em 15 de outubro de 2026, conforme o cronograma retificado.\u003C\u002Fspan\u003E\u003C\u002Fp\u003E\u003Cp\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EOs documentos da seleção podem ser consultados no menu \"Documentos\" - aba \"Editais e Seleções\" do portal da SIA.\u003C\u002Fspan\u003E\u003C\u002Fp\u003E",src:b,tag:[p,l]},{id:"7e784e529b900b38d985dc9a3f584ac4",titulo:"SIA divulga resultado preliminar da 2ª etapa da seleção de tutores do Programa de Orientação e Tutoria Inclusiva",autorfonte:"SIA",datadepublicacao:"2026-10-08",subtitulo:b,descricao:"\u003Cp\u003EA Secretaria de Inclusão e Acessibilidade (SIA) da Universidade Federal do Rio Grande do Norte (UFRN) torna público o resultado preliminar dos recursos referentes à 2ª etapa (entrevista) do processo seletivo para estudantes de graduação interessados em atuar como tutores do Programa de Orientação e Tutoria Inclusiva.\u003Cbr\u003E\u003Cbr\u003EO resultado e o cronograma com as demais datas da seleção podem ser consultados no menu \"Documentos\" - aba \"Editais e Seleções\" do portal da SIA.\u003C\u002Fp\u003E",src:b,tag:[p,l]},{id:"dffd0d4170f61d0462415c86c38be1b7",titulo:"Período para solicitação de apoio à SIA encerra no dia 8",autorfonte:o,datadepublicacao:"2026-10-05",subtitulo:b,descricao:"\u003Cp\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EA Secretaria de Inclusão e Acessibilidade (SIA) da Universidade Federal do Rio Grande do Norte (UFRN) informa que encerra nesta quinta-feira, 8 de outubro, o prazo para solicitações voluntárias de apoio educacional a estudantes com necessidades educacionais específicas para o período letivo 2026.2. O procedimento é realizado por meio do preenchimento de formulário no Sistema Integrado de Atividades Acadêmicas (\u003C\u002Fspan\u003E\u003Ca href=\"https:\u002F\u002Fsigaa.ufrn.br\u002F\" data-mce-href=\"https:\u002F\u002Fsigaa.ufrn.br\u002F\"\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003ESigaa\u003C\u002Fspan\u003E\u003C\u002Fa\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003E) - Outros - Necessidades Educacionais Específicas - Solicitar Apoio à SIA.\u003C\u002Fspan\u003E\u003C\u002Fp\u003E\u003Cp\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EO apoio se destina ao público contemplado pela \u003C\u002Fspan\u003E\u003Ca href=\"https:\u002F\u002Fwww.ufrn.br\u002Fresources\u002Fdocumentos\u002Fpoliticas\u002Fpolitica_de_Inclusao_e_Acessibilidade.pdf\" data-mce-href=\"https:\u002F\u002Fwww.ufrn.br\u002Fresources\u002Fdocumentos\u002Fpoliticas\u002Fpolitica_de_Inclusao_e_Acessibilidade.pdf\"\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EResolução nº 02\u002F2022\u003C\u002Fspan\u003E\u003C\u002Fa\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003E da UFRN, que dispõe sobre a Política de Inclusão e Acessibilidade para as Pessoas com Necessidades Específicas na UFRN. O período destinado à solicitação inicia no primeiro dia letivo de cada semestre, de acordo com o calendário acadêmico, e tem a duração de 60 dias.\u003C\u002Fspan\u003E\u003C\u002Fp\u003E\u003Cp\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EO suporte oferecido pela SIA acontece de forma individualizada, de modo a garantir as condições adequadas para acesso, permanência e participação com sucesso nas atividades acadêmicas e profissionais. A equipe da secretaria é composta por servidores de serviço social, psicologia, pedagogia e fisioterapia, assim como intérpretes de Libras e revisores de texto Braille.&nbsp;\u003C\u002Fspan\u003E\u003C\u002Fp\u003E\u003Cp\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003EOutras informações podem ser obtidas no Instagram @siaufrn, pelo e-mail \u003C\u002Fspan\u003E\u003Ca href=\"mailto:contato@sia.ufrn.br\" data-mce-href=\"mailto:contato@sia.ufrn.br\"\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003Econtato@sia.ufrn.br\u003C\u002Fspan\u003E\u003C\u002Fa\u003E\u003Cspan style=\"font-weight: 400;\" data-mce-style=\"font-weight: 400;\"\u003E ou pelo Whatsapp (84) 99474-6643. \u003C\u002Fspan\u003E\u003C\u002Fp\u003E",src:b,tag:["solicitação","apoioeducacional"]},{id:"9c2e362d0d54362296c341a6f9b235c6",titulo:"SIA divulga resultados da 1ª etapa da seleção de tutores do Programa de Orientação e Tutoria Inclusiva",autorfonte:"Lívia Saraiva de SIA\u002FUFRN",datadepublicacao:"2026-09-29",subtitulo:b,descricao:"\u003Cp\u003EA Secretaria de Inclusão e Acessibilidade (SIA) da Universidade Federal do Rio Grande do Norte (UFRN) torna público o resultado dos recursos referentes à 1ª etapa (análise documental) do processo seletivo para estudantes de graduação interessados em atuar como tutores do Programa de Orientação e Tutoria Inclusiva.\u003C\u002Fp\u003E\u003Cp\u003EOs(as) candidatos(as) que tiveram seus recursos deferidos estão aptos(as) a participar da 2ª etapa – Entrevista.\u003C\u002Fp\u003E\u003Cp\u003EO resultado dos recursos pode ser consultado \u003Cstrong\u003E\u003Ca data-mce-href=\"https:\u002F\u002Farquivos.info.ufrn.br\u002Farquivos\u002F20262211113d0f19250034f53e350b03bd\u002Fresultado-recursos-1etapa.pdf\" href=\"https:\u002F\u002Farquivos.info.ufrn.br\u002Farquivos\u002F20262211113d0f19250034f53e350b03bd\u002Fresultado-recursos-1etapa.pdf\" class=\"link\" target=\"_blank\" rel=\"noopener\"\u003EAQUI\u003C\u002Fa\u003E\u003C\u002Fstrong\u003E.\u003C\u002Fp\u003E\u003Cp\u003EA SIA também divulga a relação completa dos candidatos habillitados a participar da 2ª etapa do processo seletivo (entrevistas).\u003C\u002Fp\u003E\u003Cp\u003EArquivo disponível \u003Cstrong\u003E\u003Ca data-mce-href=\"https:\u002F\u002Farquivos.info.ufrn.br\u002Farquivos\u002F20260640440cf11925004406072ad86080\u002Fconvocacao-entrevistas.pdf\" href=\"https:\u002F\u002Farquivos.info.ufrn.br\u002Farquivos\u002F20260640440cf11925004406072ad86080\u002Fconvocacao-entrevistas.pdf\" class=\"link\" target=\"_blank\" rel=\"noopener\"\u003EAQUI\u003C\u002Fa\u003E\u003C\u002Fstrong\u003E.\u003C\u002Fp\u003E\u003Ch3\u003E\u003Cbr\u003E\u003C\u002Fh3\u003E\u003Ch3\u003E\u003Cstrong\u003EEntrevistas\u003C\u002Fstrong\u003E\u003C\u002Fh3\u003E\u003Cp\u003EConforme a retificação do cronograma do processo seletivo, as entrevistas da 2ª etapa poderão ser realizadas nos dias 30 de setembro e 1º, 2, 5 e 6 de outubro de 2026.\u003C\u002Fp\u003E\u003Cp\u003EOs(as) candidatos(as) convocados(as) deverão ficar atentos ao e-mail informado no ato da inscrição, pois a equipe do Programa utilizará esse canal para comunicar a data, o horário e as orientações para realização da entrevista.\u003C\u002Fp\u003E\u003Cp\u003ERecomenda-se também a verificação da caixa de spam ou lixo eletrônico, a fim de evitar a perda de comunicações referentes ao agendamento.\u003C\u002Fp\u003E",src:b,tag:["bolsa","tutoria",l,"nee","sia"]}],noticiasFiltrada:[],totalResults:117,totalPages:20,totalPagesFilter:f,totalResultsFilter:f,filters:{text:b,keyword:b,date:b},historyPage:y,tagsNoticias:[],loading:c},orientacoes:{formacaoContinuada:[],loadFormacaoContinuada:d,pagina:[],loadpagina:d,alunosPossuemNecessidadesEspecificas:[],loadAlunosPossuemNecessidadesEspecificas:d},publicacoesAcademicas:{infoPublicacoes:[],load:c},servicos:{imagens:[{id:"f2148b34445970dd35bad3bf5f92ad9e",img:{show:d,src:"\u002F_nuxt\u002Fimg\u002Fguia-apoio-estudantil.b05394a.svg",title:b,alt:"três silhuetas representando pessoas com deficiência: uma pessoa na cadeira de rodas usando sinais, uma pessoa cega e uma pessoa com aparelho auditivo segurando papéis"},link:{show:d,href:"https:\u002F\u002Fwww.ufrn.br\u002Finstitucional\u002Fguia-de-apoio-estudantil",title:b,alt:"Botão azul para acessar a página do guia de apoio",label:"Acesse aqui o guia de apoio"}},{id:"a1a508c90a3e7361a95b127aadcc17b0",img:{show:d,src:"\u002F_nuxt\u002Fimg\u002FTradução e interpretação de Libras.6857192.svg",title:b,alt:"Silhueta de um homem de camiseta azul com a mão direita leventada"},link:{show:d,href:"https:\u002F\u002Fufrn.br\u002Fservicos\u002Finterprete-libras",title:E,alt:F,label:G}},{id:"680280b9a427018a70c3143c86939b91",img:{show:c,src:"\u002F_nuxt\u002Fimg\u002FProdução de material em formato acessível.33569b9.svg",title:b,a